# Copia questo file in .env e inserisci i tuoi valori. Il file .env non va MAI committato.

# --- Back end (segreto) ---
# Chiave da https://developer.nytimes.com (abilita Top Stories API e Article Search API).
# La legge solo il proxy: non finisce mai nel bundle del front end.
NYT_API_KEY=la_tua_chiave

# --- Front end (pubblico) ---
# Le variabili VITE_* vengono scritte nel JavaScript servito al browser: niente segreti qui.
# DSN del progetto Sentry (opzionale in locale: se vuoto Sentry resta spento).
VITE_SENTRY_DSN=
